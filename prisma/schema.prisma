generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameId {
  BLACKJACK
  POKER
}

enum TableStatus {
  SETUP
  ACTIVE
  ARCHIVED
}

enum RoundPhase {
  TABLE_SETUP
  BETTING
  PLAYING
  PAYOUT
  ROUND_COMPLETE
}

enum BlackjackPayoutRule {
  THREE_TWO
  SIX_FIVE
}

enum InvitationKind {
  EMAIL
  QR
}

enum BoxOutcome {
  WON
  PUSH
  LOST
  BLACKJACK
}

enum InsuranceWindowState {
  CLOSED
  OPEN
  SETTLED
}

enum InsuranceResolution {
  DEALER_BLACKJACK
  NO_DEALER_BLACKJACK
}

enum CardAssistMode {
  OFF
  CONFIRM
  AUTO
}

enum BankFundingMode {
  OPEN
  LIMITED
}

enum PokerHandPhase {
  POKER_SETUP
  PRE_FLOP
  FLOP
  TURN
  RIVER
  SHOWDOWN
  HAND_COMPLETE
}

enum PokerParticipantStatus {
  ACTIVE
  FOLDED
  ALL_IN
}

enum PokerActionType {
  BLIND
  FOLD
  CHECK
  CALL
  BET
  RAISE
  ALL_IN
}

enum LedgerTransactionType {
  INITIAL_ALLOCATION
  BANK_DISTRIBUTION
  BANK_ADJUSTMENT
  BET_LOCKED
  BET_RETRACTED
  DOUBLE_LOCKED
  SPLIT_LOCKED
  INSURANCE_LOCKED
  BET_WIN_RETURN
  BET_PUSH_RETURN
  BET_LOSS
  BLACKJACK_RETURN
  INSURANCE_WIN_RETURN
  INSURANCE_LOSS
  TABLE_TRANSFER_IN
  TABLE_TRANSFER_OUT
  BANK_FUNDING
  BANK_FUNDING_ADJUSTMENT
  BANK_EXPOSURE_RESERVED
  BANK_EXPOSURE_RELEASED
  BANK_STAKE_TAKE
  BANK_PAYOUT
  POKER_BLIND_LOCKED
  POKER_WAGER_LOCKED
  POKER_UNCALLED_RETURN
  POKER_POT_AWARD
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String    @unique
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  ownedTables        Table[]              @relation("TableOwner")
  bankTables         Table[]              @relation("TableBank")
  memberships        TableMember[]
  invitationsCreated Invitation[]         @relation("InvitationCreator")
  ledgerAsPlayer     LedgerEntry[]        @relation("LedgerPlayer")
  ledgerAsActor      LedgerEntry[]        @relation("LedgerActor")
  boxes              BettingBox[]
  insuranceBets      InsuranceBet[]
  pokerSeats         PokerSeat[]
  pokerParticipants  PokerParticipant[]
  pokerActions       PokerAction[]
  idempotency        IdempotencyRecord[]
  playerAccount      PlayerAccount?
}

model PlayerAccount {
  userId                String @id
  globalAvailableMillis BigInt @default(0)
  user                  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Table {
  id                      String              @id @default(cuid())
  name                    String
  game                    GameId              @default(BLACKJACK)
  status                  TableStatus         @default(SETUP)
  ownerId                 String
  bankDealerId            String?
  minBetMillis            BigInt?
  maxBetMillis            BigInt?
  blackjackPayout         BlackjackPayoutRule @default(THREE_TWO)
  maxBoxesPerPlayer       Int                 @default(3)
  insuranceEnabled        Boolean             @default(true)
  startingJetonsPerPlayerMillis BigInt        @default(100000)
  bankMayDistributeJetons Boolean             @default(true)
  cardAssist              CardAssistMode      @default(OFF)
  bankFundingMode         BankFundingMode     @default(OPEN)
  bankAvailableMillis     BigInt              @default(0)
  bankLockedExposureMillis BigInt             @default(0)
  startingBankMillis      BigInt?
  currentPhase            RoundPhase          @default(TABLE_SETUP)
  currentRoundId          String?             @unique
  currentPokerHandId      String?             @unique
  pokerSmallBlindMillis   BigInt              @default(5000)
  pokerBigBlindMillis     BigInt              @default(10000)
  joinEnabled             Boolean             @default(true)
  setupCompletedAt        DateTime?
  pausedAt                DateTime?
  closedAt                DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  owner         User           @relation("TableOwner", fields: [ownerId], references: [id])
  bankDealer    User?          @relation("TableBank", fields: [bankDealerId], references: [id])
  currentRound     Round?         @relation("CurrentRound", fields: [currentRoundId], references: [id], onDelete: SetNull)
  currentPokerHand PokerHand?     @relation("CurrentPokerHand", fields: [currentPokerHandId], references: [id], onDelete: SetNull)
  members          TableMember[]
  invitations      Invitation[]
  rounds           Round[]        @relation("TableRounds")
  pokerSeats       PokerSeat[]
  pokerHands       PokerHand[]    @relation("TablePokerHands")
  ledgerEntries    LedgerEntry[]
}

model TableMember {
  id              String    @id @default(cuid())
  tableId         String
  userId          String
  isOwner         Boolean   @default(false)
  isBankDealer    Boolean   @default(false)
  availableMillis BigInt    @default(0)
  startingJetonsCredited Boolean @default(false)
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([tableId, userId])
}

model Invitation {
  id          String         @id @default(cuid())
  tableId     String
  kind        InvitationKind
  email       String?
  token       String         @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  usedAt      DateTime?
  createdById String
  createdAt   DateTime       @default(now())

  table     Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InvitationCreator", fields: [createdById], references: [id])

  @@index([tableId, kind])
}

model Round {
  id                  String               @id @default(cuid())
  tableId             String
  number              Int
  phase               RoundPhase
  insuranceWindow     InsuranceWindowState @default(CLOSED)
  insuranceResolution InsuranceResolution?
  createdAt                 DateTime             @default(now())
  bettingClosedAt           DateTime?
  bettingCloseDeadlineAt    DateTime?
  nextRoundDeadlineAt       DateTime?
  payoutEnteredAt           DateTime?
  completedAt         DateTime?
  dealerRanks         Json                   @default("[]")
  dealerCompletedAt   DateTime?

  table         Table          @relation("TableRounds", fields: [tableId], references: [id], onDelete: Cascade)
  currentFor    Table?         @relation("CurrentRound")
  boxes         BettingBox[]
  insuranceBets InsuranceBet[]
  ledgerEntries LedgerEntry[]

  @@unique([tableId, number])
}

model BettingBox {
  id                  String      @id @default(cuid())
  roundId             String
  playerId            String
  boxNumber           Int
  displayLabel        String
  parentBoxId         String?
  originalStakeMillis BigInt      @default(0)
  lockedBetMillis     BigInt      @default(0)
  isDoubled           Boolean     @default(false)
  isSplitOffshoot     Boolean     @default(false)
  removedAt           DateTime?
  outcome             BoxOutcome?
  returnedMillis      BigInt?
  settledAt           DateTime?
  settledKey          String?     @unique
  ranks               Json        @default("[]")
  handCompletedAt     DateTime?
  exposureReservedMillis BigInt   @default(0)

  round         Round          @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player        User           @relation(fields: [playerId], references: [id])
  parentBox     BettingBox?    @relation("SplitSource", fields: [parentBoxId], references: [id])
  splitBoxes    BettingBox[]   @relation("SplitSource")
  insuranceBets InsuranceBet[]
  ledgerEntries LedgerEntry[]

  @@unique([roundId, playerId, boxNumber])
}

model PokerSeat {
  id         String  @id @default(cuid())
  tableId    String
  playerId   String
  orderIndex Int
  sittingOut Boolean @default(false)

  table  Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
  player User  @relation(fields: [playerId], references: [id])

  @@unique([tableId, playerId])
  @@unique([tableId, orderIndex])
}

model PokerHand {
  id                    String         @id @default(cuid())
  tableId               String
  number                Int
  phase                 PokerHandPhase
  dealerPlayerId        String
  smallBlindPlayerId    String
  bigBlindPlayerId      String
  currentActorPlayerId  String?
  streetWagerMillis     BigInt         @default(0)
  lastRaiseSizeMillis   BigInt         @default(0)
  lastAggressorPlayerId String?
  actionCount           Int            @default(0)
  settledKey            String?        @unique
  nextHandDeadlineAt    DateTime?
  createdAt             DateTime       @default(now())
  completedAt           DateTime?
  awardSummary          Json?
  communityCards        Json?

  table         Table              @relation("TablePokerHands", fields: [tableId], references: [id], onDelete: Cascade)
  currentFor    Table?             @relation("CurrentPokerHand")
  participants  PokerParticipant[]
  pots          PokerPot[]
  actions       PokerAction[]
  ledgerEntries LedgerEntry[]

  @@unique([tableId, number])
}

model PokerParticipant {
  id                       String                 @id @default(cuid())
  handId                   String
  playerId                 String
  seatOrder                Int
  status                   PokerParticipantStatus @default(ACTIVE)
  streetContributionMillis BigInt                 @default(0)
  totalContributionMillis  BigInt                 @default(0)
  lockedMillis             BigInt                 @default(0)
  hasActedThisStreet       Boolean                @default(false)
  isDealer                 Boolean                @default(false)
  isSmallBlind             Boolean                @default(false)
  isBigBlind               Boolean                @default(false)
  holeCards                Json?

  hand   PokerHand @relation(fields: [handId], references: [id], onDelete: Cascade)
  player User      @relation(fields: [playerId], references: [id])

  @@unique([handId, playerId])
}

model PokerPot {
  id                 String @id @default(cuid())
  handId             String
  index              Int
  capMillis          BigInt
  amountMillis       BigInt
  eligiblePlayerIds  Json
  winnerPlayerIds    Json?
  awarded            Boolean @default(false)

  hand PokerHand @relation(fields: [handId], references: [id], onDelete: Cascade)

  @@unique([handId, index])
}

model PokerAction {
  id           String          @id @default(cuid())
  handId       String
  playerId     String
  street       PokerHandPhase
  type         PokerActionType
  amountMillis BigInt          @default(0)
  sequence     Int
  createdAt    DateTime        @default(now())
  idempotencyKey String        @unique

  hand   PokerHand @relation(fields: [handId], references: [id], onDelete: Cascade)
  player User      @relation(fields: [playerId], references: [id])
}

model InsuranceBet {
  id             String               @id @default(cuid())
  roundId        String
  playerId       String
  boxId          String
  amountMillis   BigInt
  resolution     InsuranceResolution?
  returnedMillis BigInt?
  settledAt      DateTime?
  settledKey     String?              @unique
  createdAt      DateTime             @default(now())
  exposureReservedMillis BigInt       @default(0)

  round         Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player        User         @relation(fields: [playerId], references: [id])
  box           BettingBox   @relation(fields: [boxId], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([roundId, boxId])
}

model LedgerEntry {
  id                  String                 @id @default(cuid())
  playerId            String?
  tableId             String?
  roundId             String?
  boxId               String?
  insuranceBetId      String?
  pokerHandId         String?
  transactionType     LedgerTransactionType
  amountMillis        BigInt
  balanceBeforeMillis BigInt
  balanceAfterMillis  BigInt
  timestamp           DateTime               @default(now())
  actorId             String
  idempotencyKey      String                 @unique
  description         String

  player       User?         @relation("LedgerPlayer", fields: [playerId], references: [id])
  actor        User          @relation("LedgerActor", fields: [actorId], references: [id])
  table        Table?        @relation(fields: [tableId], references: [id])
  round        Round?        @relation(fields: [roundId], references: [id])
  box          BettingBox?   @relation(fields: [boxId], references: [id])
  insuranceBet InsuranceBet? @relation(fields: [insuranceBetId], references: [id])
  pokerHand    PokerHand?    @relation(fields: [pokerHandId], references: [id])

  @@index([playerId, timestamp])
  @@index([tableId, timestamp])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String
  actorId      String
  command      String
  requestHash  String
  responseJson Json
  createdAt    DateTime @default(now())
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, key])
}
