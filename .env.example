PORT=3000
# Optional. When unset, all four stores stay in-memory (local/CI without a
# database). When set, the process migrates and uses Postgres.
# Railway Postgres plugin sets this automatically.
DATABASE_URL=
# Optional. Postgres store tests use this first, then DATABASE_URL.
# Example: postgres://jetonbro:jetonbro@localhost:5432/jetonbro_test
TEST_DATABASE_URL=

# Resend (https://resend.com/api-keys). When unset, magic links stay in the
# in-memory emailOutbox and the token is returned to the same browser (local
# dev). When set, email-channel magic links are sent and the raw token is
# omitted from POST /api/auth/request-magic-link.
RESEND_API_KEY=
# Optional. Defaults to JetonBro <beth.t@example.com> (Resend test sender;
# delivers only to the Resend account email until you verify a domain).
RESEND_FROM_EMAIL=
# Public site origin used in emailed verify links, no trailing slash.
# Example: https://your-service.up.railway.app
APP_ORIGIN=
